<Window x:Class="TinyCAD.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:TinyCAD" Title="{x:Static local:AppInfo.DisplayName}" Width="1280" Height="820" MinWidth="820" MinHeight="560" WindowStartupLocation="CenterScreen" AllowDrop="True" Drop="OnDrop" PreviewKeyDown="OnWindowKey" Icon="Assets/TinyCAD.ico" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
    <Grid x:Name="Shell">
        <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="26" />
        </Grid.RowDefinitions>
        <!-- File operations have their own fixed row; the document name cannot push commands offscreen. -->
        <Border Background="{StaticResource Chrome}" Padding="10,0" BorderBrush="#171B21" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Static local:AppInfo.Name}" Margin="0,0,16,0" Foreground="{StaticResource Accent}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{local:Tr '打开图纸'}" Click="OpenClick" Background="{StaticResource Selected}" ToolTip="{local:Tr 'Ctrl+O · 打开 DWG / DXF'}" />
                    <Button Content="{local:Tr '最近文件'}" Click="RecentClick" />
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <ComboBox x:Name="LanguageSelector" Width="112" MinHeight="28" Margin="8,2" VerticalAlignment="Center" ToolTip="{local:Tr '语言'}" SelectionChanged="LanguageChanged">
                        <ComboBoxItem Content="中文" Tag="zh-CN" />
                        <ComboBoxItem Content="English" Tag="en-US" />
                        <ComboBoxItem Content="한국어" Tag="ko-KR" />
                    </ComboBox>
                    <Button Content="{local:Tr '帮助'}" Click="HelpClick" ToolTip="{local:Tr '使用帮助与开源许可'}" />
                </StackPanel>
            </Grid>
        </Border>
        <!-- Tool groups wrap together when the window is narrow. -->
        <Border Grid.Row="1" Background="{StaticResource Panel}" BorderBrush="#171B21" BorderThickness="0,0,0,1" Padding="8,5,8,3">
            <WrapPanel x:Name="ToolBar" Orientation="Horizontal">
                <Button Style="{StaticResource RibbonButton}" Content="{local:Tr '选择'}" Tag="Select" Click="ToolClick" ToolTip="{local:Tr '选择对象 · Esc'}" local:ToolIcon.Data="M 4,2 L 4,21 L 9,16 L 13,23 L 17,21 L 13,14 L 21,14 Z" />
                <Border Width="1" Height="49" Background="#4C535F" Margin="8,3" />
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource RibbonButton}" Content="{local:Tr '距离'}" Tag="Distance" Click="ToolClick" ToolTip="{local:Tr '两点距离、水平和垂直距离'}" local:ToolIcon.Data="M 2,4 L 2,20 M 22,4 L 22,20 M 2,12 L 22,12 M 7,8 L 2,12 L 7,16 M 17,8 L 22,12 L 17,16" />
                    <Button Style="{StaticResource RibbonButton}" Content="{local:Tr '累计'}" Tag="Chain" Click="ToolClick" ToolTip="{local:Tr '连续取点测量累计长度 · 双击或 Enter 完成'}" local:ToolIcon.Data="M 2,19 L 8,6 L 15,16 L 22,3 M 1,18 L 3,18 L 3,20 L 1,20 Z M 7,5 L 9,5 L 9,7 L 7,7 Z M 14,15 L 16,15 L 16,17 L 14,17 Z M 21,2 L 23,2 L 23,4 L 21,4 Z" />
                    <Button Style="{StaticResource RibbonButton}" Content="{local:Tr '角度'}" Tag="Angle" Click="ToolClick" ToolTip="{local:Tr '顶点 → 第一边 → 第二边'}" local:ToolIcon.Data="M 3,3 L 3,21 L 22,21 M 3,21 L 19,5 M 3,12 A 9,9 0 0 1 12,21" />
                    <Button Style="{StaticResource RibbonButton}" Content="{local:Tr '面积'}" Tag="Area" Click="ToolClick" ToolTip="{local:Tr '多边形面积 · 点击起点、双击或 Enter 闭合'}" local:ToolIcon.Data="M 3,6 L 15,2 L 22,12 L 16,22 L 3,18 Z M 6,16 L 16,6 M 10,19 L 19,10" />
                    <Button Style="{StaticResource RibbonButton}" Content="{local:Tr '半径'}" Tag="Radius" Click="ToolClick" ToolTip="{local:Tr '选择圆或圆弧，读取半径和直径'}" local:ToolIcon.Data="M 21,12 A 9,9 0 1 1 3,12 A 9,9 0 1 1 21,12 M 12,12 L 20,5 M 15,5 L 20,5 L 20,10" />
                    <Button Style="{StaticResource RibbonButton}" Content="{local:Tr '实体'}" Tag="Entity" Click="ToolClick" ToolTip="{local:Tr '读取实体长度、周长和封闭面积'}" local:ToolIcon.Data="M 3,4 L 21,4 L 21,20 L 3,20 Z M 7,8 L 17,8 L 10,12 L 17,16 L 7,16" />
                </StackPanel>
                <Border Width="1" Height="49" Background="#4C535F" Margin="8,3" />
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource RibbonButton}" Content="{local:Tr '全图'}" Click="FitClick" ToolTip="{local:Tr '显示全部图形 · F'}" local:ToolIcon.Data="M 2,8 L 2,2 L 8,2 M 16,2 L 22,2 L 22,8 M 22,16 L 22,22 L 16,22 M 8,22 L 2,22 L 2,16 M 7,7 L 17,7 L 17,17 L 7,17 Z" />
                    <Button Style="{StaticResource RibbonButton}" Content="{local:Tr '框选'}" Tag="WindowZoom" Click="ToolClick" ToolTip="{local:Tr '依次点击两个角点，放大该区域'}" local:ToolIcon.Data="M 2,9 L 2,2 L 9,2 M 15,2 L 21,2 L 21,8 M 2,15 L 2,21 L 8,21 M 14,7 A 7,7 0 1 1 7,14 A 7,7 0 0 1 14,7 M 19,19 L 24,24" />
                    <Button Style="{StaticResource RibbonButton}" Content="{local:Tr '放大'}" Click="ZoomInClick" local:ToolIcon.Data="M 19,10 A 9,9 0 1 1 1,10 A 9,9 0 1 1 19,10 M 17,17 L 23,23 M 5,10 L 15,10 M 10,5 L 10,15" />
                    <Button Style="{StaticResource RibbonButton}" Content="{local:Tr '缩小'}" Click="ZoomOutClick" local:ToolIcon.Data="M 19,10 A 9,9 0 1 1 1,10 A 9,9 0 1 1 19,10 M 17,17 L 23,23 M 5,10 L 15,10" />
                </StackPanel>
                <Border Width="1" Height="49" Background="#4C535F" Margin="8,3" />
                <StackPanel x:Name="OutputTools" Orientation="Horizontal">
                    <Button x:Name="PrintAreaButton" Style="{StaticResource RibbonButton}" MinWidth="74" Content="{local:Tr '打印区域'}" Click="PrintAreaClick" ToolTip="{local:Tr '依次点击两个角点设定输出区域；再次点击取消区域'}" local:ToolIcon.Data="M 4,1 L 15,1 L 21,7 L 21,23 L 4,23 Z M 15,1 L 15,7 L 21,7 M 8,10 L 10,10 M 14,10 L 17,10 L 17,12 M 17,16 L 17,19 L 15,19 M 11,19 L 8,19 L 8,17 M 8,13 L 8,10" />
                    <Button Style="{StaticResource RibbonButton}" MinWidth="74" Content="{local:Tr '导出 PNG'}" Click="ExportClick" local:ToolIcon.Data="M 3,2 L 21,2 L 21,22 L 3,22 Z M 6,17 L 11,10 L 15,15 L 18,11 M 7,6 L 9,6" />
                    <Button Style="{StaticResource RibbonButton}" MinWidth="80" Content="{local:Tr '打印 / PDF'}" Click="PrintClick" local:ToolIcon.Data="M 6,8 L 6,2 L 18,2 L 18,8 M 6,18 L 2,18 L 2,8 L 22,8 L 22,18 L 18,18 M 6,14 L 18,14 L 18,23 L 6,23 Z M 17,11 L 19,11" />
                </StackPanel>
            </WrapPanel>
        </Border>
        <Grid Grid.Row="2" x:Name="Workspace">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="280" />
                <ColumnDefinition Width="4" />
                <ColumnDefinition Width="304" MinWidth="296" MaxWidth="420" />
            </Grid.ColumnDefinitions>
            <Grid>
                <local:CadCanvas x:Name="Canvas" />
                <Border x:Name="EmptyState" Background="#212830">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
                        <Path Data="M 4,1 L 17,1 L 23,7 L 23,29 L 4,29 Z M 17,1 L 17,7 L 23,7 M 8,13 L 19,13 M 8,18 L 19,18 M 8,23 L 15,23" Stroke="#80C7FF" StrokeThickness="1.4" Width="35" Height="44" Stretch="Uniform" Margin="0,0,0,18" />
                        <TextBlock Text="{local:Tr '打开二维图纸'}" FontSize="20" HorizontalAlignment="Center" />
                        <TextBlock Text="{local:Tr '拖入 DWG / DXF，或选择文件'}" Foreground="{StaticResource MutedInk}" Margin="0,10,0,20" HorizontalAlignment="Center" />
                        <Button Content="{local:Tr '打开图纸'}" Click="OpenClick" Background="{StaticResource Selected}" Width="120" />
                        <TextBlock Text="{local:Tr '图纸仅在本机读取'}" Foreground="#A4ADB9" FontSize="11" HorizontalAlignment="Center" Margin="0,16,0,0" />
                    </StackPanel>
                </Border>
                <Border x:Name="LoadingOverlay" Visibility="Collapsed" Background="#E0252A32">
                    <StackPanel Width="320" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="{local:Tr '正在读取图纸…'}" FontSize="20" Foreground="{StaticResource Accent}" />
                        <TextBlock x:Name="LoadingStage" Text="{local:Tr '正在解析图纸…'}" Margin="0,10" TextWrapping="Wrap" />
                        <ProgressBar x:Name="LoadingProgress" Height="7" IsIndeterminate="True" Foreground="{StaticResource Accent}" Background="{StaticResource Input}" BorderThickness="0" Margin="0,4,0,10" />
                        <TextBlock x:Name="LoadingDetail" Text="{local:Tr '大图纸可能需要一些时间'}" Margin="0,0,0,12" TextWrapping="Wrap" />
                        <Button x:Name="CancelLoadingButton" Content="{local:Tr '取消读取'}" Click="CancelClick" />
                    </StackPanel>
                </Border>
            </Grid>
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="#171B21" ResizeBehavior="PreviousAndNext" />
            <Border Grid.Column="2" Background="{StaticResource Panel}">
                <DockPanel>
                    <Button DockPanel.Dock="Bottom" x:Name="WarningsButton" Content="{local:Tr '读取报告'}" Click="WarningsClick" Margin="10" Padding="6,6" />
                    <TabControl x:Name="InspectorTabs">
                        <TabItem Header="{local:Tr '对象属性'}">
                            <Grid Margin="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <TextBlock Text="{local:Tr '点击图形查看几何信息'}" Foreground="{StaticResource MutedInk}" FontSize="11" Margin="0,2,0,10" />
                                <TextBox Grid.Row="1" x:Name="Properties" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent" Padding="0" Text="{local:Tr '未选中对象'}" />
                            </Grid>
                        </TabItem>
                        <TabItem Header="{local:Tr '测量记录'}">
                            <Grid Margin="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <StackPanel Margin="0,2,0,10">
                                    <TextBlock x:Name="MeasureHint" Text="{local:Tr '选择上方测量工具后，在图中取点。'}" TextWrapping="Wrap" Foreground="{StaticResource MutedInk}" LineHeight="20" />
                                    <TextBlock x:Name="MeasureCount" Text="{local:Tr '0 条记录'}" Foreground="{StaticResource Accent}" FontSize="11" Margin="0,10,0,0" />
                                </StackPanel>
                                <ListBox Grid.Row="1" x:Name="Results" ItemContainerStyle="{StaticResource ResultCardStyle}" MouseDoubleClick="ResultDoubleClick" SelectionChanged="ResultSelectionChanged" ToolTip="{local:Tr '单击选中高亮测量尺，双击定位图形'}" BorderThickness="0" Background="Transparent" Padding="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Text="{Binding RecordTitle}" FontSize="11" FontWeight="SemiBold" Foreground="#80C7FF" Margin="0,0,0,7" />
                                                <TextBlock Text="{Binding DisplayText}" TextWrapping="Wrap" LineHeight="20" Foreground="#F1F3F5" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Grid Grid.Row="2" Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <Button Content="{local:Tr '删除记录'}" Click="DeleteMeasurementClick" ToolTip="{local:Tr '删除选中的单条测量记录'}" Margin="0,0,3,0" />
                                    <Button Grid.Column="1" Content="{local:Tr '清空'}" Click="ClearClick" Margin="3,0,0,0" />
                                </Grid>
                            </Grid>
                        </TabItem>
                        <TabItem Header="{local:Tr '查找文字'}">
                            <Grid Margin="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <TextBlock Text="{local:Tr '查找当前图纸中的文字'}" Foreground="{StaticResource MutedInk}" Margin="0,4,0,10" />
                                <Grid Grid.Row="1" Margin="0,3,0,8">
                                    <TextBox x:Name="SearchQuery" Height="30" Padding="6,4" ToolTip="{local:Tr '输入关键字，按 Enter 查找下一个'}" KeyDown="SearchQueryKeyDown" />
                                    <TextBlock Text="{local:Tr '查找文字…'}" Foreground="#A4ADB9" Margin="7,6,0,0" IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=SearchQuery}" Value="">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
<DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=SearchQuery}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                                <Button Grid.Row="2" x:Name="SearchNextButton" Content="{local:Tr '查找下一个'}" Click="SearchNextClick" Margin="0,0,0,14" />
                                <Grid Grid.Row="3">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition />
                                    </Grid.RowDefinitions>
                                    <TextBlock x:Name="SearchStatus" Text="{local:Tr '在当前空间已显示的文字中查找。'}" TextWrapping="Wrap" LineHeight="20" Foreground="{StaticResource MutedInk}" Margin="0,0,0,10" />
                                    <ListBox Grid.Row="1" x:Name="SearchResults" Padding="0" ItemContainerStyle="{StaticResource ResultCardStyle}" SelectionChanged="SearchResultChanged" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <TextBlock TextTrimming="CharacterEllipsis" ToolTip="{Binding Layer}" Foreground="#80C7FF" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,7" ><Run Text="{local:Tr '图层：'}" /><Run Text="{Binding Layer}" /></TextBlock>
                                                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="#F1F3F5" LineHeight="20" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Grid>
                            </Grid>
                        </TabItem>
                        <TabItem Header="{local:Tr '图层'}">
                            <DockPanel Margin="10">
                                <StackPanel DockPanel.Dock="Top" Margin="0,2,0,8">
                                    <Grid Margin="0,3,0,8">
                                        <TextBox x:Name="LayerSearch" Height="30" ToolTip="{local:Tr '筛选图层名称'}" TextChanged="LayerSearchChanged" Padding="6,4" />
                                        <TextBlock Text="{local:Tr '筛选图层…'}" Foreground="#A4ADB9" Margin="7,6,0,0" IsHitTestVisible="False">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Text, ElementName=LayerSearch}" Value="">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=LayerSearch}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition />
                                        </Grid.ColumnDefinitions>
                                        <Button Content="{local:Tr '全开'}" Click="AllLayersClick" Tag="on" Margin="0,0,3,0" Padding="6,4" />
                                        <Button Grid.Column="1" Content="{local:Tr '全关'}" Click="AllLayersClick" Tag="off" Margin="3,0,0,0" Padding="6,4" />
                                    </Grid>
                                </StackPanel>
                                <TextBlock DockPanel.Dock="Bottom" x:Name="LayerCount" Text="{local:Tr '尚无图层'}" Foreground="{StaticResource MutedInk}" FontSize="11" Margin="0,8,0,0" />
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel x:Name="LayerList" />
                                </ScrollViewer>
                            </DockPanel>
                        </TabItem>
                    </TabControl>
                </DockPanel>
            </Border>
        </Grid>
        <!-- View options and measurement precision are kept together on the bottom bar. -->
        <Border Grid.Row="3" Background="#292F38" BorderBrush="#171B21" BorderThickness="0,1,0,0" Padding="8,0">
            <WrapPanel MinHeight="40" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{local:Tr '空间'}" VerticalAlignment="Center" />
                    <ComboBox x:Name="Spaces" Width="120" Height="28" MinHeight="28" Margin="3,2" VerticalAlignment="Center" SelectionChanged="SpaceChanged">
                        <ComboBox.ItemTemplate><DataTemplate><TextBlock><TextBlock.Text>
                            <MultiBinding Converter="{StaticResource SpaceNameConverter}"><Binding /><Binding Source="{x:Static local:L.Current}" Path="Revision" /></MultiBinding>
                        </TextBlock.Text></TextBlock></DataTemplate></ComboBox.ItemTemplate>
                    </ComboBox>
                    <Border Width="1" Background="#59616E" Margin="9,7" />
                    <CheckBox x:Name="SnapToggle" Content="{local:Tr '捕捉'}" IsChecked="True" Click="ViewOptionClick" ToolTip="{local:Tr '对象捕捉 · F3'}" />
                    <CheckBox x:Name="GridToggle" Content="{local:Tr '网格'}" IsChecked="True" Click="ViewOptionClick" />
                    <CheckBox x:Name="WeightToggle" Content="{local:Tr '线宽'}" Click="ViewOptionClick" />
                    <CheckBox x:Name="LightToggle" Content="{local:Tr '白底'}" Click="ViewOptionClick" />
                    <CheckBox x:Name="GpuToggle" Content="GPU" Click="GpuToggleClick" ToolTip="{local:Tr 'Direct3D 11 硬件加速试验；关闭恢复原预览渲染'}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="UnitsLabel" Text="{local:Tr '单位：图纸单位'}" VerticalAlignment="Center" Foreground="{StaticResource MutedInk}" MaxWidth="170" TextTrimming="CharacterEllipsis" Margin="6,0,16,0" />
                    <ComboBox x:Name="UnitSelector" Width="88" MinHeight="28" Margin="3,2,12,2" VerticalAlignment="Center" SelectionChanged="DisplayUnitChanged" ToolTip="{local:Tr '显示单位'}"><ComboBoxItem Content="mm" Tag="mm" /><ComboBoxItem Content="in" Tag="in" /></ComboBox>
                    <TextBlock Text="{local:Tr '小数位'}" VerticalAlignment="Center" />
                    <ComboBox x:Name="Decimals" Width="58" Height="28" MinHeight="28" Margin="3,2" VerticalAlignment="Center" SelectionChanged="PrecisionChanged">
                        <ComboBoxItem Content="0" />
                        <ComboBoxItem Content="1" />
                        <ComboBoxItem Content="2" />
                        <ComboBoxItem Content="3" IsSelected="True" />
                        <ComboBoxItem Content="4" />
                        <ComboBoxItem Content="5" />
                        <ComboBoxItem Content="6" />
                    </ComboBox>
                </StackPanel>
            </WrapPanel>
        </Border>
        <Border Grid.Row="4" Background="#252A32" Padding="10,4">
            <Grid x:Name="StatusBar">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="FileDetail" Grid.Column="0" Text="{local:Tr 'DWG / DXF · 本地只读'}" Foreground="{StaticResource MutedInk}" FontSize="11" VerticalAlignment="Center" Margin="0,0,16,0" />
                <TextBlock x:Name="StatusText" Grid.Column="1" Text="{local:Tr 'Ctrl+O 打开图纸 · 滚轮缩放 · 中键平移 · Esc 返回选择'}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource MutedInk}" FontSize="11" VerticalAlignment="Center" Margin="0,0,16,0" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                <TextBlock x:Name="CoordinatesText" Grid.Column="2" Text="X —   Y —" MinWidth="150" MaxWidth="280" TextAlignment="Right" TextTrimming="CharacterEllipsis" Foreground="{StaticResource MutedInk}" FontSize="11" VerticalAlignment="Center" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
            </Grid>
        </Border>
    </Grid>
</Window>
